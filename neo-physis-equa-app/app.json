{
  "expo": {
    "name": "agrophysis",
    "slug": "agrophysis",
    "scheme": "agrophysis",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F2EA"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juancarvajalsteam.agrophysis"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b706fad7-189b-47dc-9a03-37b5b744c070"
      }
    },
    "owner": "juancarvajals-team"
  }
}
